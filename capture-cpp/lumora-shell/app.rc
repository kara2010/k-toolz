// K-Toolz-Logo (IDI_ICON1 = Suite; zugleich das Explorer-Icon der exe, weil Windows die
// erste Icon-Gruppe nimmt - Namen sortieren: IDI_ICON1 vor IDI_MOD_*) + Modul-Icons fuer
// die Anzeigename-Regel (genau ein aktives Modul -> dessen Icon) + VersionInfo der Shell.
#include <windows.h>

IDI_ICON1       ICON "app.ico"
IDI_MOD_OSD     ICON "icons/plainosd.ico"
IDI_MOD_STREAM  ICON "icons/streamtofriend.ico"
IDI_MOD_STUTTER ICON "icons/stutterhunter.ico"
IDI_MOD_WHEEL   ICON "icons/wheeltopad.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 4,1,0,0
 PRODUCTVERSION 4,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Karsten Radermacher"
            VALUE "FileDescription", "K-Toolz"
            VALUE "FileVersion", "4.1.0.0"
            VALUE "InternalName", "k-toolz"
            VALUE "LegalCopyright", "\xA9 Karsten Radermacher"
            VALUE "OriginalFilename", "k-toolz.exe"
            VALUE "ProductName", "K-Toolz"
            VALUE "ProductVersion", "4.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
