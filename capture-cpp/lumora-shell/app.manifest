<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Anwendungsmanifest der Shell. GEMESSEN (2026-10-25): ohne dieses Manifest bettet der MSVC-Linker
     nur requestedExecutionLevel ein - KEINE Common-Controls v6 -> alle nativen Dialoge (MessageBox der
     Einrichtung: "OSD einrichten", "Ruckler-Analyse einrichten", Fehlerboxen) erscheinen im klassischen
     Windows-95-Stil ohne Visual Styles. Mit v6 zeichnet Windows sie im aktuellen Systemstil.
     DPI: PerMonitorV2 hier deklariert; der Aufruf SetProcessDpiAwarenessContext in main.cpp bleibt als
     Rueckfall fuer aeltere Systeme (liefert dann nur FALSE, weil bereits gesetzt). -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity type="win32" name="K-Toolz.Shell" version="1.0.0.0" processorArchitecture="amd64"/>
  <dependency>
    <dependentAssembly>
      <assemblyIdentity type="win32" name="Microsoft.Windows.Common-Controls" version="6.0.0.0"
                        processorArchitecture="*" publicKeyToken="6595b64144ccf1df" language="*"/>
    </dependentAssembly>
  </dependency>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 / 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
    </windowsSettings>
  </application>
</assembly>
